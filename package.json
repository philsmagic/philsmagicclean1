  },
  "dependencies": {
    "@astrojs/sitemap": "^3.4.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^5.12.0",
    "tailwindcss": "^4.1.0"
  }
