{
  "name": "philsmagicclean-aeo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/strip-comments.mjs && node scripts/validate-schema.mjs",
