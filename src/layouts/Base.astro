---
/**
 * Base layout. Everything a crawler needs is in the initial HTML: title,
 * description, ONE absolute canonical, robots directives, OG tags, and the
 * page's JSON-LD graph (always Organization + Person + WebSite + WebPage,
 * plus whatever the page adds).
 */
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import JsonLd from "@/components/JsonLd.astro";
import { SITE_URL, GA_ID, META_PIXEL_ID, PROD_HOSTS, BUSINESS } from "@/data/site";
import { organization, person, website, webPage } from "@/data/schema";

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/services". Defaults to the current route. */
  path?: string;
  /** Extra schema nodes for this page (Service, BlogPosting, FAQPage, BreadcrumbList…). */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  ogImage?: string;
}
const { title, description, path = Astro.url.pathname.replace(/\/$/, "") || "/", schema = [], noindex = false, ogImage } = Astro.props;
const canonical = `${SITE_URL}${path === "/" ? "/" : path}`;
const graph = [organization, person, website, webPage(path, title, description), ...schema];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex
    ? <meta name="robots" content="noindex, follow" />
    : <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={BUSINESS.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage ?? BUSINESS.logo} />
  <link rel="icon" href="/images/logo-stacked.png" type="image/png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Fonts load without blocking first paint (display=swap; system fallback until they arrive). -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;800;900&family=Source+Sans+3:wght@400;600&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;800;900&family=Source+Sans+3:wght@400;600&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;800;900&family=Source+Sans+3:wght@400;600&display=swap" /></noscript>

  <JsonLd data={graph} />

  <!-- ANALYTICS — PRODUCTION HOSTNAME ONLY (Sable stop-the-bleeding, 2026-10-05).
       Localhost and every preview host send NOTHING to GA4 or Meta; key events
       fired from a preview are indistinguishable from real quote requests and
       poison the before/after baseline. The hostname check is the gate; the
       build mode alone is not enough because `astro preview` is a PROD build. -->
  <script is:inline define:vars={{ GA_ID, META_PIXEL_ID, PROD_HOSTS }}>
    (function () {
      var h = location.hostname;
      window.__pmAnalytics = PROD_HOSTS.indexOf(h) !== -1;
      if (!window.__pmAnalytics) {
        // Preview/local: expose inert stubs so page code never throws, and
        // record calls for verification. Nothing leaves the browser.
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.fbq = function () { (window.__fbqRecord = window.__fbqRecord || []).push(Array.prototype.slice.call(arguments)); };
      } else {
        // --- Google tag (gtag.js) ---
        var g = document.createElement('script'); g.async = true;
        g.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        document.head.appendChild(g);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', GA_ID);

        // --- Meta Pixel ---
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', META_PIXEL_ID);
        fbq('track', 'PageView'); // one per real page load — this is a multi-page static site
      }

      // GA4 key event `phone_tap` (Sable, 2026-10-05): every tel: click on every
      // route — header, footer, buttons, inline numbers. E.L. stars the event in
      // GA4 once it appears, so the name must match exactly; never rename it.
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('a[href^="tel:"]');
        if (!a) return;
        gtag('event', 'phone_tap', {
          phone_number: a.getAttribute('href').replace('tel:', ''),
          link_text: (a.textContent || '').trim().slice(0, 60),
          page_path: location.pathname
        });
      }, true);

      // A click through to a Jobber request form is the conversion that
      // matters. Meta `Lead` (shipped as PR #11 on the old site) and GA4
      // `quote_click` share one determination so the two systems reconcile.
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('a[href]');
        if (!a) return;
        if (a.href.indexOf('clienthub.getjobber.com') === -1) return;
        var janitorial = a.href.indexOf('5126135') !== -1;
        fbq('track', 'Lead', {
          content_name: janitorial ? 'Janitorial request form' : 'General request form'
        });
        gtag('event', 'quote_click', {
          request_type: janitorial ? 'janitorial' : 'general',
          link_url: a.href,
          page_path: location.pathname
        });
      }, true);
    })();
  </script>
  <!-- No <noscript> pixel image: it cannot be hostname-gated and would ping Meta from previews. -->
</head>
<body class="min-h-screen flex flex-col">
  <Header />
  <main class="flex-1 pt-16">
    <slot />
  </main>
  <Footer />
</body>
</html>
