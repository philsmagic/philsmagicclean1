---
/** Final call-to-action band. One teal action per screen (brand system §4). */
import { BUSINESS, REQUEST_FORM_URL } from "@/data/site";
interface Props { heading?: string; text?: string; formUrl?: string; formLabel?: string }
const {
  heading = "Ready for a Spotless Space?",
  text = "Call Phil directly for a free quote. He answers his own phone. Most jobs scheduled within the week.",
  formUrl = REQUEST_FORM_URL,
  formLabel = "Request a quote online",
} = Astro.props;
---
<section class="bg-ink py-16 text-center">
  <div class="container mx-auto px-4 max-w-7xl">
    <h2 class="text-3xl md:text-4xl text-white mb-4">{heading}</h2>
    <p class="text-gray-300 mb-4 max-w-xl mx-auto">{text}</p>
    <a href={`tel:${BUSINESS.phoneE164}`} class="block text-2xl font-black text-white mb-6 no-underline" style="font-family: var(--font-display)">{BUSINESS.phoneDisplay}</a>
    <div class="flex flex-wrap justify-center gap-4">
      <a href={formUrl} target="_blank" rel="noopener noreferrer" class="btn btn-action">{formLabel}</a>
      <a href="/contact" class="btn btn-outline-white">Send a Message</a>
    </div>
  </div>
</section>
