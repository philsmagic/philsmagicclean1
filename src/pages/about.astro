---
/**
 * About — the COMPANY page. Emily Matthews' AEO copy (Assets/aeo-copy-2026-10-05/md/About.md),
 * carried verbatim except the home-cleaning substitutions required by E.L.'s ruling of
 * 2026-10-05 (flagged inline; docs/EMILY-CHANGES.md). The Person entity's URL is now
 * /meet-magic-phil (schema.ts); this page links there. Sentence-case headings are Emily's.
 */
import Base from "@/layouts/Base.astro";
import Toc from "@/components/Toc.astro";
import Faq from "@/components/Faq.astro";
import CtaBand from "@/components/CtaBand.astro";
import { breadcrumbs, faqPage } from "@/data/schema";

const path = "/about";
const title = "About Phil's Magic Cleaning | San Francisco Peninsula";
const description =
  "Phil's Magic Cleaning provides reliable, detailed professional cleaning for homes and businesses across the San Francisco Peninsula.";

const faq = [
  {
    q: "Is Phil's Magic Cleaning a local company?",
    a: "Yes. Phil's Magic Cleaning is a locally operated professional cleaning company serving homes and businesses across the San Francisco Peninsula, with a primary service area extending from South San Francisco to Mountain View.",
  },
  {
    q: "Does Phil's Magic Cleaning serve both homes and businesses?",
    a: "Yes. Phil's Magic Cleaning serves both homes and businesses across the San Francisco Peninsula with janitorial and general cleaning and residential and commercial window cleaning. One-time and recurring service is available.",
  },
];

const toc = [
  { id: "who-is-magic-phil", label: "Who is Magic Phil?" },
  { id: "how-it-started", label: "How did Phil's Magic Cleaning get started?" },
  { id: "services", label: "What cleaning services does Phil's Magic Cleaning provide?" },
  { id: "where-we-serve", label: "Where does Phil's Magic Cleaning serve customers?" },
  { id: "what-makes-us-different", label: "What makes Phil's Magic Cleaning different?" },
  { id: "licensed-and-insured", label: "Is Phil's Magic Cleaning licensed and insured?" },
  { id: "locally-trusted", label: "Is Phil's Magic Cleaning locally trusted?" },
  { id: "contact", label: "How can I contact Phil's Magic Cleaning?" },
  { id: "faq", label: "Frequently asked questions about Phil's Magic Cleaning" },
];
---
<Base {title} {description} {path} schema={[breadcrumbs([{ name: "Home", path: "/" }, { name: "About", path }]), faqPage(path, faq)]}>
  <article class="container mx-auto px-4 max-w-4xl py-12">
    <nav aria-label="Breadcrumb" class="text-sm text-muted mb-4"><ol class="flex gap-2 list-none p-0 m-0"><li><a href="/">Home</a></li><li aria-hidden="true">›</li><li aria-current="page">About</li></ol></nav>

    <h1 class="text-4xl md:text-5xl mt-2 mb-4">Who is Phil's Magic Cleaning?</h1>
    <p class="text-lg text-muted max-w-3xl leading-relaxed">
      Phil's Magic Cleaning is a locally operated company providing professional cleaning for homes and businesses, including window cleaning, across the San Francisco Peninsula.
    </p>
    <p class="mt-4"><a href="/meet-magic-phil">Meet Magic Phil — the founder's story</a></p>
    <div class="brand-rule max-w-xs my-6"></div>
    <Toc items={toc} />

    <section id="who-is-magic-phil" class="mt-12">
      <h2 id="who-is-magic-phil-heading" class="text-2xl md:text-3xl mb-4">Who is Magic Phil?</h2>
      <p class="leading-relaxed">Magic Phil is the founder of Phil's Magic Cleaning, a locally operated cleaning company serving homes and businesses across the San Francisco Peninsula. He built the company through hands-on service, customer relationships, and a focus on detailed, reliable cleaning.</p>
      <p class="mt-6"><a href="/meet-magic-phil" class="btn btn-outline">More about Phil</a></p>
    </section>

    <section id="how-it-started" class="border-t border-line pt-12 mt-12">
      <h2 id="how-it-started-heading" class="text-2xl md:text-3xl mb-4">How did Phil's Magic Cleaning get started?</h2>
      <div class="space-y-4 leading-relaxed">
        <p>Phil's Magic Cleaning started with professional window cleaning and built its reputation through detailed work and strong customer relationships. The company has since expanded its professional cleaning services for homes and businesses across the San Francisco Peninsula.</p>
        <p>That window-cleaning foundation shaped the company's approach to all its services: detailed work, reliable service, and personalized attention to each property.</p>
      </div>
    </section>

    <section id="services" class="border-t border-line pt-12 mt-12">
      <h2 id="services-heading" class="text-2xl md:text-3xl mb-4">What cleaning services does Phil's Magic Cleaning provide?</h2>
      <p class="leading-relaxed">Phil's Magic Cleaning provides professional cleaning for homes and businesses, including janitorial and general cleaning and residential and commercial window cleaning. One-time and recurring services are available across the San Francisco Peninsula.</p>
      <!-- EMILY: home-cleaning wording changed per E.L. ruling 10/5 — original button: "View commercial and home cleaning services" -->
      <div class="flex flex-wrap gap-3 mt-6">
        <a href="/janitorial-cleaning" class="btn btn-outline">View commercial cleaning services</a>
        <a href="/window-cleaning" class="btn btn-outline">View window cleaning services</a>
      </div>
    </section>

    <section id="where-we-serve" class="border-t border-line pt-12 mt-12">
      <h2 id="where-we-serve-heading" class="text-2xl md:text-3xl mb-4">Where does Phil's Magic Cleaning serve customers?</h2>
      <p class="leading-relaxed">Phil's Magic Cleaning serves homes and businesses across the San Francisco Peninsula, with a primary service area from South San Francisco to Mountain View.</p>
      <p class="mt-6"><a href="/service-areas" class="btn btn-outline">View all service areas</a></p>
    </section>

    <section id="what-makes-us-different" class="border-t border-line pt-12 mt-12">
      <h2 id="what-makes-us-different-heading" class="text-2xl md:text-3xl mb-4">What makes Phil's Magic Cleaning different?</h2>
      <p class="leading-relaxed">Phil's Magic Cleaning differentiates its service through personalized cleaning plans, attention to detail, reliable scheduling, and direct customer relationships.</p>
      <ul class="grid grid-cols-1 sm:grid-cols-3 gap-6 list-none p-0 mt-8">
        <li class="bg-wash rounded-lg p-5">
          <h3 id="personalized-service" class="font-bold mb-1">Personalized service</h3>
          <p class="text-sm text-muted leading-relaxed">Phil's Magic Cleaning tailors service to each property's cleaning requirements and preferred schedule rather than using the same approach for every home or business.</p>
        </li>
        <li class="bg-wash rounded-lg p-5">
          <h3 id="attention-to-detail" class="font-bold mb-1">Attention to detail</h3>
          <p class="text-sm text-muted leading-relaxed">Phil's Magic Cleaning built its reputation through professional window cleaning, where results are immediately visible. The same focus on thorough work and attention to detail extends across the company's cleaning services.</p>
        </li>
        <li class="bg-wash rounded-lg p-5">
          <h3 id="reliable-service" class="font-bold mb-1">Reliable service</h3>
          <p class="text-sm text-muted leading-relaxed">Phil's Magic Cleaning provides reliable scheduling and consistent service for one-time and recurring customers. Customer reviews also document repeat and long-term relationships with residential and commercial customers.</p>
        </li>
      </ul>
    </section>

    <section id="licensed-and-insured" class="border-t border-line pt-12 mt-12">
      <h2 id="licensed-and-insured-heading" class="text-2xl md:text-3xl mb-4">Is Phil's Magic Cleaning licensed and insured?</h2>
      <p class="leading-relaxed">Yes. Phil's Magic Cleaning is licensed and insured for residential and commercial cleaning.</p>
    </section>

    <section id="locally-trusted" class="border-t border-line pt-12 mt-12">
      <h2 id="locally-trusted-heading" class="text-2xl md:text-3xl mb-4">Is Phil's Magic Cleaning locally trusted?</h2>
      <div class="space-y-4 leading-relaxed">
        <!-- REVIEW E.L.: named clients — FASTSIGNS, Baking Arts, Burlingame Tobacconist, Belfor Restoration (Emily's copy). -->
        <p>Yes. Phil's Magic Cleaning has served homeowners and local businesses across the San Francisco Peninsula, including FASTSIGNS, Baking Arts, Burlingame Tobacconist, and Belfor Restoration.</p>
        <p>Customer reviews cite reliable scheduling, detailed work, professionalism, and high-quality results for residential and commercial properties.</p>
      </div>
      <p class="mt-6"><a href="/reviews" class="btn btn-outline">Read customer reviews</a></p>
    </section>

    <section id="contact" class="border-t border-line pt-12 mt-12">
      <h2 id="contact-heading" class="text-2xl md:text-3xl mb-4">How can I contact Phil's Magic Cleaning?</h2>
      <p class="leading-relaxed">Contact Phil's Magic Cleaning to discuss professional cleaning for your home or business on the San Francisco Peninsula or request a free estimate.</p>
      <p class="mt-6"><a href="/contact" class="btn btn-action">Get a free estimate</a></p>
    </section>

    <Faq
      items={faq}
      heading="Frequently asked questions about Phil's Magic Cleaning"
      intro="Find answers about Phil's Magic Cleaning, its customers, service area, and professional cleaning services."
    />
  </article>

  <CtaBand
    heading="Ready to Experience the Difference?"
    text="Call Phil directly. He answers his own phone and gives honest assessments and fair prices."
  />
</Base>
