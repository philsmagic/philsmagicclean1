---
/**
 * "Related articles" nav for the window-cleaning resource articles (Emily Matthews' copy,
 * 2026-10-07). Each doc lists one sibling article + the bold "Professional window cleaning
 * overview" block. The overview block's link in every doc is the malformed placeholder
 * `LINK TO Resources_Window cleaning resource center]` (missing "[") → /resources/window-cleaning
 * per docs/CONVENTIONS.md. Bold on the overview H3/paragraph is dropped (headings are bold
 * already; body styled like the sibling item). Underscore prefix: Astro does not route this file.
 */
interface Props { title: string; blurb: string; href: string; linkText: string }
const { title, blurb, href, linkText } = Astro.props;
---
<nav aria-label="Related articles" class="my-12">
  <h2 id="related-articles" class="text-2xl md:text-3xl mb-6">Related articles</h2>
  <ul class="space-y-8">
    <li>
      <h3 class="text-xl mb-2">{title}</h3>
      <p class="leading-relaxed mb-2">{blurb}</p>
      <a href={href} class="font-bold">{linkText}</a>
    </li>
    <li>
      <h3 class="text-xl mb-2">Professional window cleaning overview</h3>
      <p class="leading-relaxed mb-2">This hub provides an overview of professional window cleaning for homeowners and businesses, including what services can include, DIY versus professional cleaning, choosing a provider, cleaning frequency, post-construction cleanup, and cleaning hard-to-reach and multi-story windows.</p>
      <!-- EMILY: link placeholder was "LINK TO Resources_Window cleaning resource center]" (missing "[") → linked to /resources/window-cleaning -->
      <a href="/resources/window-cleaning" class="font-bold">Go to the window cleaning resource center</a>
    </li>
  </ul>
</nav>
