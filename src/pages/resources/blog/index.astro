---
/**
 * Blog (news) index — copy from Emily Matthews' AEO pass (2026-10-05),
 * Resources_Blog.md, carried verbatim. Each post is an H2 + date + blurb +
 * her link text, in her order. Breadcrumb: Home › Resources › Blog.
 * The three body-less teaser posts from the old site are not in her copy and
 * are gone from posts.ts until she writes them.
 */
import Base from "@/layouts/Base.astro";
import CtaBand from "@/components/CtaBand.astro";
import { getPost, displayDate } from "@/data/posts";
import { breadcrumbs } from "@/data/schema";

const path = "/resources/blog";
const title = "Phil’s Magic Cleaning news & announcements";
const description =
  "Get Phil’s Magic Cleaning news and updates about services, scheduling, invoicing, and other changes for San Francisco Peninsula customers.";

// Order and link text per Emily's doc.
const entries = [
  { post: getPost("janitorial-services")!, linkText: "Explore expanded cleaning services" },
  { post: getPost("new-system")!, linkText: "Review the system update" },
];
---
<Base {title} {description} {path} schema={[breadcrumbs([{ name: "Home", path: "/" }, { name: "Resources", path: "/resources" }, { name: "Blog", path }])]}>
  <section class="container mx-auto px-4 max-w-7xl py-12">
    <nav aria-label="Breadcrumb" class="text-sm text-muted mb-4">
      <ol class="flex gap-2">
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/resources">Resources</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">Blog</li>
      </ol>
    </nav>

    <h1 class="text-4xl md:text-5xl mb-4">Phil’s Magic cleaning news and announcements</h1>
    <p class="text-lg text-muted max-w-3xl">
      Get the latest Phil’s Magic Cleaning news, including service announcements, scheduling and invoicing updates, and other changes affecting customers across the San Francisco Peninsula.
    </p>
    <div class="brand-rule max-w-xs my-6"></div>

    <div class="max-w-3xl space-y-10 mt-12">
      <!-- EMILY: link target in doc looked like a paste error (both blocks pointed at the scheduling-and-invoicing post); linked the "expands commercial and janitorial" block to the janitorial post -->
      {entries.map(({ post, linkText }) => (
        <article class="border-b border-line pb-10 last:border-0">
          <h2 class="text-xl md:text-2xl mb-2">{post.title}</h2>
          <p class="text-sm text-muted mb-3"><time datetime={post.datePublished}>{displayDate(post.datePublished)}</time></p>
          <p class="text-muted leading-relaxed mb-4">{post.excerpt}</p>
          <p><a href={`/resources/blog/${post.slug}`}>{linkText}</a></p>
        </article>
      ))}
    </div>
  </section>

  <CtaBand />
</Base>
