---
/**
 * Service Areas — Emily Matthews' AEO copy (Assets/aeo-copy-2026-10-05/md/Service Areas.md),
 * carried verbatim except the home-cleaning substitutions required by E.L.'s ruling of
 * 2026-10-05 (each one flagged inline and logged in docs/EMILY-CHANGES.md).
 * Sentence-case headings are deliberate (Emily). Per-city write-ups from the live site are
 * replaced by her copy. SERVICE_AREA (site.ts) still drives schema areaServed.
 */
import Base from "@/layouts/Base.astro";
import Toc from "@/components/Toc.astro";
import Faq from "@/components/Faq.astro";
import CtaBand from "@/components/CtaBand.astro";
import { breadcrumbs, faqPage } from "@/data/schema";

const path = "/service-areas";
const title = "SF Peninsula Service Areas | Phil's Magic Cleaning";
// EMILY: home-cleaning wording changed per E.L. ruling 10/5 — original: "…with commercial, home, janitorial, and window cleaning."
const description =
  "Phil's Magic Cleaning serves homes and businesses from South San Francisco to Mountain View with commercial, janitorial, and window cleaning.";

// REVIEW E.L.: city list differs from site.ts — Emily lists 8 named cities + "Other communities";
// SERVICE_AREA has 14 (adds San Bruno, Hillsborough, Belmont, San Carlos, Menlo Park, Los Altos).
// Her visible copy is kept; the schema's areaServed still uses SERVICE_AREA.
const cities = [
  "South San Francisco",
  "Millbrae",
  "Burlingame",
  "San Mateo",
  "Foster City",
  "Redwood City",
  "Palo Alto",
  "Mountain View",
  "Other communities along the San Francisco Peninsula",
];

const faq = [
  {
    q: "Can I request cleaning if I am near the edge of Phil's service area?",
    a: "Yes. Customers near the edges of Phil's Magic Cleaning's primary South San Francisco-to-Mountain View service area can contact Phil's to confirm availability. Service depends on the property location, type of cleaning requested, and scheduling availability.",
  },
  {
    q: "Does Phil's Magic Cleaning provide service outside the listed cities?",
    a: "Phil's Magic Cleaning primarily serves communities from South San Francisco to Mountain View. Customers in other communities along the San Francisco Peninsula can contact Phil's to confirm whether service is available for their location and requested cleaning service.",
  },
  {
    // EMILY: home-cleaning wording changed per E.L. ruling 10/5 — original: "…to confirm available commercial, home, janitorial, or window cleaning services."
    q: "Are all cleaning services available in every city?",
    a: "Service availability depends on the property location and type of cleaning requested. Contact Phil's Magic Cleaning with your city, property type, and cleaning needs to confirm available commercial, janitorial, or window cleaning services.",
  },
];

const toc = [
  { id: "areas-served", label: "What areas does Phil's Magic Cleaning serve?" },
  { id: "services-across-area", label: "What cleaning services does Phil's Magic Cleaning provide across its service area?" },
  { id: "homes-and-businesses", label: "Does Phil's Magic Cleaning serve both homes and businesses across the Peninsula?" },
  { id: "why-choose", label: "Why choose Phil's Magic Cleaning for Peninsula cleaning services?" },
  { id: "confirm-availability", label: "How can I confirm cleaning service is available in my area?" },
  { id: "faq", label: "Frequently asked questions about Phil's Magic Cleaning service areas" },
];
---
<Base
  {title}
  {description}
  {path}
  schema={[breadcrumbs([{ name: "Home", path: "/" }, { name: "Service Areas", path }]), faqPage(path, faq)]}
>
  <article class="container mx-auto px-4 max-w-7xl py-12">
    <nav aria-label="Breadcrumb" class="text-sm text-muted mb-4">
      <ol class="flex gap-2 list-none p-0 m-0">
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">Service Areas</li>
      </ol>
    </nav>

    <h1 class="text-4xl md:text-5xl mt-2 mb-4">Where does Phil's Magic Cleaning provide cleaning services?</h1>
    <!-- EMILY: home-cleaning wording changed per E.L. ruling 10/5 — original: "Services include commercial, janitorial, home, and window cleaning." -->
    <p class="text-lg text-muted max-w-3xl">
      Phil's Magic Cleaning provides professional cleaning for homes and businesses across the San Francisco Peninsula, with a primary service area from South San Francisco to Mountain View. Services include commercial, janitorial, and window cleaning.
    </p>
    <div class="brand-rule max-w-xs my-6"></div>
    <Toc items={toc} />

    <section id="areas-served" class="mt-12">
      <h2 id="areas-served-heading" class="text-2xl md:text-3xl mb-4">What areas does Phil's Magic Cleaning serve?</h2>
      <div class="max-w-3xl space-y-4 leading-relaxed">
        <p>Phil's Magic Cleaning serves communities across the San Francisco Peninsula from South San Francisco to Mountain View, including Millbrae, Burlingame, San Mateo, Foster City, Redwood City, and Palo Alto.</p>
        <p>Service areas include:</p>
        <!-- REVIEW E.L.: city list differs from site.ts (Emily: 8 cities + "Other communities"; SERVICE_AREA: 14) -->
        <ul class="list-disc pl-6 space-y-1">
          {cities.map((c) => <li>{c}</li>)}
        </ul>
        <p>Service availability depends on the property location and type of cleaning requested.</p>
      </div>
    </section>

    <section id="services-across-area" class="border-t border-line pt-12 mt-12">
      <h2 id="services-across-area-heading" class="text-2xl md:text-3xl mb-4">What cleaning services does Phil's Magic Cleaning provide across its service area?</h2>
      <!-- EMILY: home-cleaning wording changed per E.L. ruling 10/5 — original: "Phil's Magic Cleaning provides commercial and janitorial cleaning for businesses, professional home cleaning for residential properties, and window cleaning for homes and businesses across the San Francisco Peninsula." -->
      <p class="max-w-3xl leading-relaxed">
        Phil's Magic Cleaning provides commercial and janitorial cleaning for businesses and window cleaning for homes and businesses across the San Francisco Peninsula. One-time and recurring options are available based on the property and cleaning needs.
      </p>
      <!-- EMILY: home-cleaning wording changed per E.L. ruling 10/5 — original button: "View commercial and home cleaning services" -->
      <div class="flex flex-wrap gap-3 mt-6">
        <a href="/janitorial-cleaning" class="btn btn-outline">View commercial cleaning services</a>
        <a href="/window-cleaning" class="btn btn-outline">View window cleaning services</a>
      </div>
    </section>

    <section id="homes-and-businesses" class="border-t border-line pt-12 mt-12">
      <h2 id="homes-and-businesses-heading" class="text-2xl md:text-3xl mb-4">Does Phil's Magic Cleaning serve both homes and businesses across the Peninsula?</h2>
      <p class="max-w-3xl leading-relaxed">
        Yes. Phil's Magic Cleaning serves both homes and businesses across the San Francisco Peninsula, including residential properties and commercial properties such as offices, restaurants, storefronts, medical and dental offices, salons, and gyms.
      </p>
    </section>

    <section id="why-choose" class="border-t border-line pt-12 mt-12">
      <h2 id="why-choose-heading" class="text-2xl md:text-3xl mb-4">Why choose Phil's Magic Cleaning for Peninsula cleaning services?</h2>
      <p class="max-w-3xl leading-relaxed">
        Phil's Magic Cleaning provides licensed and insured professional cleaning for homes and businesses across the San Francisco Peninsula. Customers choose Phil's for reliable scheduling, detailed cleaning, personalized service, and local service from South San Francisco to Mountain View.
      </p>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-6 list-none p-0 mt-8 max-w-3xl">
        <li class="bg-wash rounded-lg p-5">
          <h3 id="community-trusted" class="font-bold mb-1">Community-trusted</h3>
          <!-- REVIEW E.L.: named clients — FASTSIGNS, Baking Arts, Burlingame Tobacconist, Belfor Restoration (Emily's copy). -->
          <p class="text-sm text-muted leading-relaxed">Trusted by FASTSIGNS, Baking Arts, Burlingame Tobacconist, and Belfor Restoration for years.</p>
        </li>
        <li class="bg-wash rounded-lg p-5">
          <h3 id="licensed-and-insured" class="font-bold mb-1">Licensed and insured</h3>
          <p class="text-sm text-muted leading-relaxed">Fully covered for residential and commercial work.</p>
        </li>
      </ul>
    </section>

    <section id="confirm-availability" class="border-t border-line pt-12 mt-12">
      <h2 id="confirm-availability-heading" class="text-2xl md:text-3xl mb-4">How can I confirm cleaning service is available in my area?</h2>
      <p class="max-w-3xl leading-relaxed">
        Contact Phil's Magic Cleaning to confirm service availability and request a free estimate. Provide your city, property type, cleaning needs, and whether you are interested in one-time or recurring service.
      </p>
      <p class="mt-6"><a href="/contact" class="btn btn-action">Get a free estimate</a></p>
    </section>

    <Faq
      items={faq}
      heading="Frequently asked questions about Phil's Magic Cleaning service areas"
      intro="These answers cover Phil's Magic Cleaning's geographic service area and how to confirm cleaning service availability for a specific location."
    />
  </article>

  <CtaBand />
</Base>
